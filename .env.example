# OmniTradePro — environment configuration (EXAMPLE ONLY)
#
# Copy to `.env.local` and set your own values. NEVER commit a real value, and never reuse the
# placeholders below as if they were real. No credential, token, key or seed belongs in this file
# in version control.
#
# Security posture of this build: PAPER / RESEARCH ONLY. LIVE execution is blocked in code.

# ---------------------------------------------------------------------------
# Trading mode
# ---------------------------------------------------------------------------
# Forced to PAPER by the engine regardless of this value; it exists for diagnostics only.
# Do not attempt to enable live trading: the order router refuses non-paper modes.
TRADING_MODE=paper

# ---------------------------------------------------------------------------
# API authentication (REQUIRED for any deployment reachable beyond loopback)
# ---------------------------------------------------------------------------
# When set (>= 8 chars), EVERY mutating request must send:
#     Authorization: Bearer <token>
# A value shorter than 8 characters is NOT ignored: it is refused with 401 AUTH_MISCONFIGURED, because
# silently ignoring it would remove authentication while appearing configured. An empty value counts as unset.
# The browser UI reads the token from localStorage["omni_api_token"].
# Generate your own value, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OMNI_API_TOKEN=

# Set to `true` ONLY if this server is bound to this machine and used by a single local operator.
# The API guard cannot see the peer socket, so the absence of proxy headers is not evidence of
# locality (SEC-011). Without OMNI_API_TOKEN and without this assertion, every mutation is denied
# with 401 AUTH_NOT_CONFIGURED — that is intentional, not a bug.
OMNI_LOCAL_TRUST=false

# Set to `true` only when a reverse proxy you control sits in front of the app AND overwrites
# X-Forwarded-For. The guard then trusts the NEAREST (last) hop only. Client-prepended entries are
# never trusted. Leave unset when the app is reached directly.
OMNI_TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Credential vault
# ---------------------------------------------------------------------------
# Passphrase for the encrypted credential vault. The vault fails closed without it: missing or
# short (< 8 chars) values raise VaultKeyMissingError and the vault API returns 503.
# There is no fallback key. Generate your own; keep it out of version control.
VAULT_KEY=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local SQLite file by default. Contains paper-trading state only — never broker credentials.
DATABASE_URL=file:./data/omnitrade.db

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# * Rate limiting is per-process and in-memory (SEC-009). Multi-instance deployment is NOT
#   supported and remains blocked; a shared store would be required first.
# * The webhook endpoint (/api/v1/webhook) has no configured secret variable in this build; it
#   accepts calls only from a client the guard considers local under the rules above.
# * Full per-variable reference (accepted values, invalid-value behaviour, security implications):
#   CONFIGURATION.md. Verified by `node scripts/env_config_probe.js`.
